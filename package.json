{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 5000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 5000",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backend:install": "cd backend && uv venv .venv && uv pip install --python .venv/bin/python -r requirements.txt",
    "backend:dev": "cd backend && .venv/bin/python -m uvicorn app.main:app --reload --port 8000"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "lucide-react": "^1.74.0",
    "next": "^15.5.29",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "3.4",
    "typescript": "5.9",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
