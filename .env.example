# Local development: copy this file to .env.local and fill in the values.
# Supabase project settings: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Canonical frontend origin used in Supabase auth email links.
# Set this to your deployed domain in production (never localhost).
NEXT_PUBLIC_APP_ORIGIN=https://your-frontend-domain.vercel.app
FASTAPI_BACKEND_URL=http://127.0.0.1:8000
GITHUB_TOKEN=

# Restart npm run dev after changing environment variables.
